# Roma — environment configuration.
# Copy to .env and fill in real values. .env is gitignored; NEVER commit secrets.

# --- Twilio (optional at startup; required for outbound carrier operations) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Secrets (required; env-only per docs/07) ---
SARVAM_API_KEY=
OPENAI_API_KEY=
REDIS_URL=

# --- PostgreSQL system of record -------------------------------------------------------
# Async SQLAlchemy requires the asyncpg driver prefix. Leave DATABASE_URL empty for
# offline utilities that do not use persistence. Alembic/demo tools need only this
# database credential, not voice-provider/Redis secrets. See docs/21-database-migrations.md.
DATABASE_URL=
# Secret key used to deterministically hash PII before it is stored. Use at least 32 bytes.
PII_HASH_KEY=
# Section 13 advisory slot leases and short operation bounds; no transaction crosses Redis/audio.
BOOKING_HOLD_TTL_SECS=90
BOOKING_DB_TIMEOUT_SECS=3
BOOKING_REDIS_TIMEOUT_SECS=1
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECS=5.0
# All processes owning a DB engine, including API replicas and workers/dispatcher.
# One engine's threads/tasks share its pool. Update when scaling processes.
DATABASE_POOL_PROCESSES=1
# Optional explicit allocation: (size + overflow) * processes must fit this limit.
# Set after checking actual max_connections, reserved slots and other clients.
DATABASE_CONNECTION_BUDGET=

# --- Provider selection ---------------------------------------------------------------
# Mocks are deterministic and safe for automated tests. Local/cloud adapters are selected
# here when their later level gates install models, credentials and benchmarks.
STT_PROVIDER=mock
# OpenAI text provider: model/key from environment; tests/console default to mocks.
# Set OPENAI_MODEL to the existing approved model before any authorized paid run.
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=256
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_PROMPT_BYTES=16384
OPENAI_ATTEMPT_TIMEOUT_SECS=4
OPENAI_TURN_TIMEOUT_SECS=10
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_BACKOFF_SECS=0.25
OPENAI_CALL_TOKEN_BUDGET=20000
OPENAI_CALL_SPEND_CAP_INR=2
TTS_PROVIDER=mock
EMBEDDING_PROVIDER=mock
TELEPHONY_PROVIDER=twilio

# --- Google Calendar (OPTIONAL; both or neither) ---
# When both are set, Roma stops offering slots the counsellor's diary already has booked
# (roma.controller.gcal). With neither she books against branch hours alone, as before.
# The calendar must be shared publicly for an API key to read it.
# READ-ONLY BY CONSTRUCTION: an API key cannot create the visit event. Writing the booking
# back needs a service-account credential and is post-call work, not turn work.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# --- Non-secret operational settings ---
APP_ENV=dev
LOG_LEVEL=INFO

# Where Twilio reaches this process. HTTPS, no trailing slash. Dev = your cloudflared tunnel
# URL; prod = the public origin (UNDECIDED - see docs/decisions.md).
# Twilio needs BOTH: it requests <PUBLIC_BASE_URL>/answer when the callee picks up, then opens
# a websocket to the wss:// form of the same base at /ws. One setting keeps them aligned.
PUBLIC_BASE_URL=https://localhost:8020

# Barge-in / interruptions (Step 5B, docs/05 Layer 3). ON by default, matching config.py.
# This shipped FALSE on an acoustic-echo theory — that without AEC Roma's own audio would
# echo back and interrupt her constantly — which measurement then disproved: across 20
# calls the lead-channel RMS while Roma speaks never exceeded 0.78x its RMS while she is
# silent (see build_user_params in media.py). The carrier separates the legs; there is no
# echo path to guard against.
ENABLE_BARGE_IN=true

# docs/05 filler token — a cached "achha…" played the instant endpointing fires, to mask
# the LLM round trip. The early "two agents clashing" complaint came from the model opening
# its reply with the same ack the clip had just played; strip_leading_ack() (filler.py)
# removes that duplication, and the picker alternates turns so the tic cannot re-form.
ENABLE_FILLER=true

# Gate 0's DENYLIST, comma-separated. Was an allowlist (CONSENTED_NUMBERS) until
# 2026-08-04 — see docs/decisions.md. Any valid INDIAN MOBILE (+91, 10 digits, opening 6-9)
# now dials unless it is listed here.
#
# EMPTY BLOCKS NOTHING, and that is the honest state: no TRAI/DLT feed is wired, so we have
# no real suppression data. What bounds this endpoint is route authorization, MAX_CALLS_PER_HOUR, the
# spend cap and the calling window — not this list.
DND_NUMBERS=+919000000001

# Optional legacy machine bearer; disabled unless AUTH_ALLOW_LEGACY_API_TOKEN=true.
# Human API access now uses JWT/RBAC. No default signing secret or Admin exists.
API_TOKEN=
AUTH_ALLOW_LEGACY_API_TOKEN=false
# Independently generate at least 32 bytes; keep the real value private.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=roma
AUTH_JWT_AUDIENCE=roma-api
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_SECS=604800
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECS=300

# Bounds what the spend cap cannot see coming: a stuck UI retry or a held-down button costs
# twenty calls, not the whole budget, and it fails in minutes rather than after the money.
MAX_CALLS_PER_HOUR=20

# /api/call rings real phones and spends real budget, so localhost is the DEFAULT and going
# wide is a deliberate act. Set 0.0.0.0 only if you mean it.
BIND_HOST=127.0.0.1

# How long a call's status row outlives the call, for the UI to poll (seconds).
CALL_STATUS_TTL_SECS=3600

# Step 6 post-call recording (docs/09). ROMA_DATA_DIR is the single root for everything
# written to disk: call audio, the post-call job spool, and the stored recordings. It holds
# LEAD PII — keep it off any shared/world-readable volume, and keep it gitignored.
ROMA_DATA_DIR=var/roma
RECORDING_ENABLED=true
# Retention window in days. PII-bearing; not "forever". Pending Weltec compliance sign-off.
RECORDING_RETENTION_DAYS=90

# Whole-testing-phase OpenAI ceiling in rupees (docs/02). MUST match the hard spend limit set
# in the OpenAI dashboard — that is the real enforcement; this is the second belt.
#
# What it buys, measured on the real prompt (~3200 tokens, ~2800 of them prefix-cached) at
# ~15 turns a call:
#
#   gpt-4o        ~Rs 0.52/turn   ~Rs 7.80/call    ~13 calls on Rs 100
#   gpt-4o-mini   ~Rs 0.04/turn   ~Rs 0.60/call   ~167 calls on Rs 100
#
# LLM_MODEL moved to gpt-4o on 2026-07-27, so the testing phase is now about THIRTEEN live
# calls, not a hundred and sixty. Spend is tracked in {ROMA_DATA_DIR}/spend.jsonl and survives
# restarts; `scripts/place_test_call.py` refuses to dial once it is gone (reason=block:budget).
OPENAI_BUDGET_INR=100

# Step 7 tuning (docs/05 config summary). They live here so tuning is an env change on the
# production origin rather than a code edit. Move ONE at a time and re-measure; the teardown
# log prints the per-call endpoint timing you are tuning against.
#
# VAD_STOP_SECS is deliberately BELOW the 0.85 endpoint default since the 2026-08-04 retune
# (call 932b6c88: ~288ms recovered per turn; pipecat rounds to 32ms frames, so 0.45 runs as
# 448ms). The two used to be the same knob; they are not any more — shipping 0.85 here again
# would silently un-tune the VAD on any fresh deploy, which is exactly what this file did
# until 2026-08-08.
VAD_STOP_SECS=0.45
ENDPOINT_TERMINAL_SECS=0.5
ENDPOINT_DEFAULT_SECS=0.85
ENDPOINT_CONTINUATION_SECS=1.3
VAD_CONFIDENCE=
VAD_MIN_VOLUME=
BACKCHANNEL_MAX_SECS=0.6

# Sections 15–17 speech lab. Defaults never load/download ASR weights or call a server.
STT_LANGUAGE=hi
STT_TIMEOUT_SECS=30
STT_MAX_AUDIO_SECS=30
INDIC_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
INDIC_MODEL_REVISION=2a77d305038dfc502fd9464e7d028b90381976cb
INDIC_TRUST_REMOTE_CODE=false
INDIC_DECODER=ctc
WHISPER_MODEL_ID=small
# Apple Silicon local prototype: STT_PROVIDER=whisper_mlx; provision pinned Turbo first.
WHISPER_MLX_MODEL_DIR=var/roma/models/whisper-large-v3-turbo-mlx-4bit
# Fixed reviewed nouns only; leave disabled until paired accuracy evaluation.
WHISPER_BOOKING_VOCABULARY=false
# Hosted custom-handler URL required in addition to a token; not a model Hub URL.
HF_ASR_ENDPOINT_URL=
HF_TOKEN=

# Existing public demos are LAB ONLY, with explicit public-benchmark metadata.
# These URLs were discovered and exercised; no paid endpoint is provisioned.
HF_INDIC_SPACE_URL=https://1219naveen-indicconformer-asr.hf.space
HF_WHISPER_SPACE_URL=https://hf-audio-whisper-large-v3.hf.space
HF_WHISPER_API_NAME=transcribe
# Explicit HF edge authentication on reviewed official Whisper hosts only.
HF_WHISPER_SPACE_AUTHENTICATED=false
# Authenticated HF router baseline (requires credits); never used as silent fallback.
HF_WHISPER_MODEL=openai/whisper-large-v3-turbo

# Public demos may queue; finite LAB timeout, not a voice latency target.
HF_PUBLIC_TIMEOUT_SECS=90

# Section 19 local TTS lab. Existing live Sarvam/assets remain unchanged.
# An explicitly provisioned isolated runtime and hashed five-file manifests are required.
INDIC_TTS_MANIFEST=
INDIC_TTS_PYTHON=
TTS_VOICE=female
TTS_TIMEOUT_SECS=60
TTS_MAX_TEXT_BYTES=4096
TTS_MAX_AUDIO_SECS=30
TTS_MAX_CONCURRENCY=1
TTS_CACHE_ENTRIES=64
TTS_CACHE_BYTES=8388608

# Claude is the active LLM; OpenAI fields above are historical compatibility only.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_PROMPT_CACHE=true
ANTHROPIC_MAX_OUTPUT_TOKENS=256
ANTHROPIC_MAX_PROMPT_BYTES=32768
ANTHROPIC_ATTEMPT_TIMEOUT_SECS=4
ANTHROPIC_TURN_TIMEOUT_SECS=10
ANTHROPIC_MAX_RETRIES=1
ANTHROPIC_RETRY_BACKOFF_SECS=0.25
ANTHROPIC_CALL_TOKEN_BUDGET=64000
ANTHROPIC_CALL_SPEND_CAP_INR=2
ANTHROPIC_BUDGET_INR=200

# Isolated prototype turn policy; does not alter production Twilio/Sarvam endpointing.
VOICE_ENDPOINT_SILENCE_MS=512
VOICE_CONTINUATION_GRACE_MS=300
VOICE_BATCH_GAP_MIN_MS=256
VOICE_MAX_UTTERANCE_MS=30000
VOICE_BATCH_MIN_TURN_MS=2000

# Batch-only rejection; ordinary single-call decoding is unchanged.
WHISPER_BATCH_NO_SPEECH=0.6
WHISPER_BATCH_AVG_LOGPROB=-1.0
WHISPER_BATCH_COMPRESSION_RATIO=2.4

# Optional JSON map of stage thresholds in milliseconds; empty means unset.
VOICE_TURN_BUDGET_MS=

PII_ENCRYPTION_ENABLED=false

PII_ENCRYPTION_KEY=

RECORDING_URL_SIGNING_KEY=

RECORDING_URL_TTL_SECS=120

PRIVACY_RETENTION_DAYS=

# Opt-in, cache-only Level9 embeddings and retrieval (no automatic downloads).
EMBEDDING_MANIFEST=
EMBEDDING_TIMEOUT_SECS=10
EMBEDDING_MAX_TEXT_BYTES=8192
EMBEDDING_MAX_BATCH_SIZE=4
EMBEDDING_CPU_THREADS=2
RAG_ENABLED=false
RAG_TOP_K=5
RAG_MIN_SCORE=0.8
RAG_RETRIEVAL_TIMEOUT_SECS=0.45
RAG_GENERATION_TIMEOUT_SECS=10
