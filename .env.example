# Roma — environment configuration.
# Copy to .env and fill in real values. .env is gitignored; NEVER commit secrets.

# --- Twilio (optional at startup; required for outbound carrier operations) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Secrets (required; env-only per docs/07) ---
SARVAM_API_KEY=
OPENAI_API_KEY=
REDIS_URL=

# --- Google Calendar (OPTIONAL; both or neither) ---
# When both are set, Roma stops offering slots the counsellor's diary already has booked
# (roma.controller.gcal). With neither she books against branch hours alone, as before.
# The calendar must be shared publicly for an API key to read it.
# READ-ONLY BY CONSTRUCTION: an API key cannot create the visit event. Writing the booking
# back needs a service-account credential and is post-call work, not turn work.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# --- Non-secret operational settings ---
APP_ENV=dev
LOG_LEVEL=INFO

# Where Twilio reaches this process. HTTPS, no trailing slash. Dev = your cloudflared tunnel
# URL; prod = the public origin (UNDECIDED - see docs/decisions.md).
# Twilio needs BOTH: it requests <PUBLIC_BASE_URL>/answer when the callee picks up, then opens
# a websocket to the wss:// form of the same base at /ws. One setting keeps them aligned.
PUBLIC_BASE_URL=https://localhost:8020

# Barge-in / interruptions (Step 5B, docs/05 Layer 3). ON by default, matching config.py.
# This shipped FALSE on an acoustic-echo theory — that without AEC Roma's own audio would
# echo back and interrupt her constantly — which measurement then disproved: across 20
# calls the lead-channel RMS while Roma speaks never exceeded 0.78x its RMS while she is
# silent (see build_user_params in media.py). The carrier separates the legs; there is no
# echo path to guard against.
ENABLE_BARGE_IN=true

# docs/05 filler token — a cached "achha…" played the instant endpointing fires, to mask
# the LLM round trip. The early "two agents clashing" complaint came from the model opening
# its reply with the same ack the clip had just played; strip_leading_ack() (filler.py)
# removes that duplication, and the picker alternates turns so the tic cannot re-form.
ENABLE_FILLER=true

# Gate 0's DENYLIST, comma-separated. Was an allowlist (CONSENTED_NUMBERS) until
# 2026-08-04 — see docs/decisions.md. Any valid INDIAN MOBILE (+91, 10 digits, opening 6-9)
# now dials unless it is listed here.
#
# EMPTY BLOCKS NOTHING, and that is the honest state: no TRAI/DLT feed is wired, so we have
# no real suppression data. What bounds this endpoint is API_TOKEN, MAX_CALLS_PER_HOUR, the
# spend cap and the calling window — not this list.
DND_NUMBERS=+919000000001

# Bearer token for /api/call. UNSET MEANS THE ENDPOINT IS DEAD (503), not open — an
# unconfigured lock must never read as "no lock needed". Generate one and keep it out of git.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Programmatic backend clients send it in the Authorization header.
API_TOKEN=

# Bounds what the spend cap cannot see coming: a stuck UI retry or a held-down button costs
# twenty calls, not the whole budget, and it fails in minutes rather than after the money.
MAX_CALLS_PER_HOUR=20

# /api/call rings real phones and spends real budget, so localhost is the DEFAULT and going
# wide is a deliberate act. Set 0.0.0.0 only if you mean it.
BIND_HOST=127.0.0.1

# How long a call's status row outlives the call, for the UI to poll (seconds).
CALL_STATUS_TTL_SECS=3600

# Step 6 post-call recording (docs/09). ROMA_DATA_DIR is the single root for everything
# written to disk: call audio, the post-call job spool, and the stored recordings. It holds
# LEAD PII — keep it off any shared/world-readable volume, and keep it gitignored.
ROMA_DATA_DIR=var/roma
RECORDING_ENABLED=true
# Retention window in days. PII-bearing; not "forever". Pending Weltec compliance sign-off.
RECORDING_RETENTION_DAYS=90

# Whole-testing-phase OpenAI ceiling in rupees (docs/02). MUST match the hard spend limit set
# in the OpenAI dashboard — that is the real enforcement; this is the second belt.
#
# What it buys, measured on the real prompt (~3200 tokens, ~2800 of them prefix-cached) at
# ~15 turns a call:
#
#   gpt-4o        ~Rs 0.52/turn   ~Rs 7.80/call    ~13 calls on Rs 100
#   gpt-4o-mini   ~Rs 0.04/turn   ~Rs 0.60/call   ~167 calls on Rs 100
#
# LLM_MODEL moved to gpt-4o on 2026-07-27, so the testing phase is now about THIRTEEN live
# calls, not a hundred and sixty. Spend is tracked in {ROMA_DATA_DIR}/spend.jsonl and survives
# restarts; `scripts/place_test_call.py` refuses to dial once it is gone (reason=block:budget).
OPENAI_BUDGET_INR=100

# Step 7 tuning (docs/05 config summary). They live here so tuning is an env change on the
# production origin rather than a code edit. Move ONE at a time and re-measure; the teardown
# log prints the per-call endpoint timing you are tuning against.
#
# VAD_STOP_SECS is deliberately BELOW the 0.85 endpoint default since the 2026-08-04 retune
# (call 932b6c88: ~288ms recovered per turn; pipecat rounds to 32ms frames, so 0.45 runs as
# 448ms). The two used to be the same knob; they are not any more — shipping 0.85 here again
# would silently un-tune the VAD on any fresh deploy, which is exactly what this file did
# until 2026-08-08.
VAD_STOP_SECS=0.45
ENDPOINT_TERMINAL_SECS=0.5
ENDPOINT_DEFAULT_SECS=0.85
ENDPOINT_CONTINUATION_SECS=1.3
VAD_CONFIDENCE=
VAD_MIN_VOLUME=
BACKCHANNEL_MAX_SECS=0.6
