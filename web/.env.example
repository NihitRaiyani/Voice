# Where the FastAPI backend lives. Never hardcode this in source: moving to a real host
# later is then a config change, not a rewrite (docs/13-web-ui.md).
VITE_API_BASE=http://localhost:8020

# Must match API_TOKEN in the backend's .env, or every request is a 401.
#
# NOT A SECRET. Vite inlines this into the JS bundle, so anyone who can load the page can
# read it. It stops another MACHINE reaching :8020; it does not stop the person at this
# keyboard. A public deploy needs a session, not this.
VITE_API_TOKEN=
